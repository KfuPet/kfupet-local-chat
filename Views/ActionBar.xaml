<UserControl x:Class="kfupet_local_chat.Views.ActionBar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Border Style="{StaticResource Card}" Padding="16">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="0,0,0,12">
                <TextBlock Text="操作" Style="{StaticResource SectionTitle}" />
                <TextBlock Text="运行本地加载模型；重置不删除 GGUF 文件" FontSize="11.5"
                           Foreground="{StaticResource FaintBrush}" HorizontalAlignment="Right"
                           VerticalAlignment="Center" />
            </Grid>

            <UniformGrid Grid.Row="1" Columns="4">
                <Button x:Name="RunLocalButton" Content="运行本地" Tag="运行本地" IsEnabled="False"
                        Style="{StaticResource PrimaryButton}" Margin="0,0,8,0" />
                <Button Content="启动控制台" Tag="启动控制台" Style="{StaticResource GhostButton}"
                        Margin="0,0,8,0" />
                <Button x:Name="ExportButton" Content="导出报告" Tag="导出报告" IsEnabled="False"
                        Style="{StaticResource GhostButton}" Margin="0,0,8,0" />
                <Button Content="清除所有数据" Tag="清除所有数据" Style="{StaticResource GhostButton}" />
            </UniformGrid>
        </Grid>
    </Border>
</UserControl>
