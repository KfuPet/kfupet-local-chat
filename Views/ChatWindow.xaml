<Window x:Class="kfupet_local_chat.Views.ChatWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="主对话 · 每轮记忆提取"
        Width="1180" Height="760" MinWidth="920" MinHeight="560"
        WindowStartupLocation="CenterOwner"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        FontFamily="Microsoft YaHei UI" FontSize="13"
        Foreground="{StaticResource InkBrush}">
    <Window.Background>
        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#F8F9FB" Offset="0" />
            <GradientStop Color="#EDEFF3" Offset="1" />
        </LinearGradientBrush>
    </Window.Background>

    <Grid Margin="22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock Text="主对话" FontSize="18" FontWeight="SemiBold" />
            <TextBlock Margin="0,4,0,0" Style="{StaticResource HintText}"
                       Text="主人发一句、摇摇回一句算一轮。每轮回复后都会判断这一轮有没有值得长期记住的信息，而不是等整个会话结束。" />
        </StackPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="320" />
            </Grid.ColumnDefinitions>

            <!-- 对话区 -->
            <Border Grid.Column="0" Style="{StaticResource Card}" Margin="0" Padding="16">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,10">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="8" Height="8" Fill="{StaticResource AccentBrush}"
                                     VerticalAlignment="Center" />
                            <TextBlock Text="对话" Style="{StaticResource SectionTitle}" Margin="8,0,0,0" />
                        </StackPanel>
                        <TextBlock x:Name="ModelStatusText" Text="检查模型状态…" FontSize="11"
                                   Foreground="{StaticResource FaintBrush}" HorizontalAlignment="Right"
                                   VerticalAlignment="Center" />
                    </Grid>

                    <Border Grid.Row="1" Background="#FAFBFD" CornerRadius="9"
                            BorderBrush="{StaticResource LineBrush}" BorderThickness="1" Padding="8,4">
                        <ScrollViewer x:Name="TranscriptScroll" VerticalScrollBarVisibility="Auto"
                                      Style="{StaticResource ThinScrollViewer}">
                            <StackPanel x:Name="ChatPanel" Margin="6,4,6,8" />
                        </ScrollViewer>
                    </Border>

                    <Grid Grid.Row="2" Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBox x:Name="InputBox" Style="{StaticResource FieldInput}" MinHeight="40"
                                 VerticalContentAlignment="Center" KeyDown="OnInputKeyDown"
                                 ToolTip="和摇摇说点什么…" />
                        <Button Grid.Column="1" Content="发送" Click="OnSendClick"
                                Style="{StaticResource PrimaryButton}" MinWidth="88" Margin="10,0,0,0" />
                    </Grid>

                    <TextBlock Grid.Row="3" Style="{StaticResource HintText}" Margin="0,8,0,0"
                               Text="按回车发送。提取在回复之后自动进行，结果会显示在对话流和右侧长期记忆里。" />
                </Grid>
            </Border>

            <!-- 长期记忆 -->
            <Border Grid.Column="2" Style="{StaticResource Card}" Margin="0" Padding="16">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,10">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="8" Height="8" Fill="{StaticResource SuccessBrush}"
                                     VerticalAlignment="Center" />
                            <TextBlock Text="长期记忆" Style="{StaticResource SectionTitle}" Margin="8,0,0,0" />
                        </StackPanel>
                        <TextBlock x:Name="MemoryCountText" Text="0 条" FontSize="11"
                                   Foreground="{StaticResource FaintBrush}" HorizontalAlignment="Right"
                                   VerticalAlignment="Center" />
                    </Grid>

                    <Grid Grid.Row="1">
                        <TextBlock x:Name="MemoryEmptyText" Text="还没有长期记忆&#x0a;多聊几句试试"
                                   FontSize="12" Foreground="{StaticResource FaintBrush}"
                                   TextAlignment="Center" HorizontalAlignment="Center"
                                   VerticalAlignment="Center" />
                        <ScrollViewer VerticalScrollBarVisibility="Auto" Style="{StaticResource ThinScrollViewer}">
                            <ItemsControl x:Name="MemoryList">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="#FAFBFD" BorderBrush="{StaticResource LineBrush}"
                                                BorderThickness="1" CornerRadius="8" Padding="10,8"
                                                Margin="0,0,0,8">
                                            <StackPanel>
                                                <Grid>
                                                    <Border Background="{StaticResource AccentSoftBrush}"
                                                            CornerRadius="4" Padding="6,1"
                                                            HorizontalAlignment="Left">
                                                        <TextBlock Text="{Binding ImportanceText}" FontSize="10"
                                                                   Foreground="{StaticResource AccentBrush}" />
                                                    </Border>
                                                    <TextBlock Text="{Binding TimeText}" FontSize="10"
                                                               Foreground="{StaticResource FaintBrush}"
                                                               HorizontalAlignment="Right"
                                                               VerticalAlignment="Center" />
                                                </Grid>
                                                <TextBlock Text="{Binding Content}" FontSize="12"
                                                           Foreground="{StaticResource SubBrush}"
                                                           TextWrapping="Wrap" LineHeight="19"
                                                           Margin="0,6,0,0" />
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>

                    <StackPanel Grid.Row="2" Margin="0,10,0,0">
                        <TextBlock Style="{StaticResource HintText}" Margin="0,0,0,8"
                                   Text="最多保留 100 条；下一轮对话会按重要性注入前 8 条。1.7B 仅支持对话，不做记忆提炼。" />
                        <Button Content="清空记忆" Click="OnClearMemoriesClick"
                                Style="{StaticResource GhostButton}" HorizontalAlignment="Right"
                                Padding="12,6" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
