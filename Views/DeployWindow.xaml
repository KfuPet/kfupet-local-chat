<Window x:Class="kfupet_local_chat.Views.DeployWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="选择要部署的本地模型"
        Width="880" Height="760" MinWidth="820" MinHeight="680"
        WindowStartupLocation="CenterOwner"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        FontFamily="Microsoft YaHei UI" FontSize="13"
        Foreground="{StaticResource InkBrush}">
    <Window.Background>
        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#F8F9FB" Offset="0" />
            <GradientStop Color="#EDEFF3" Offset="1" />
        </LinearGradientBrush>
    </Window.Background>

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />

        <Style x:Key="ThinProgressBar" TargetType="ProgressBar">
            <Setter Property="Height" Value="6" />
            <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
            <Setter Property="Background" Value="{StaticResource LineBrush}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ProgressBar">
                        <Grid>
                            <Border Background="{TemplateBinding Background}" CornerRadius="3" />
                            <Grid x:Name="PART_Track">
                                <Border x:Name="PART_Indicator" Background="{TemplateBinding Foreground}"
                                        CornerRadius="3" HorizontalAlignment="Left" />
                            </Grid>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ModelItemStyle" TargetType="ListBoxItem">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="AutomationProperties.Name" Value="{Binding Name}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Bd" Background="White" CornerRadius="10"
                                BorderBrush="{StaticResource LineBrush}" BorderThickness="1"
                                Padding="14,12" Margin="0,0,0,8">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#D4D4D8" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#F7FAFF" />
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <DataTemplate x:Key="ModelTemplate">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="SemiBold"
                                   Foreground="{StaticResource InkBrush}" VerticalAlignment="Center" />
                        <Border Background="{StaticResource SoftBrush}" CornerRadius="4"
                                Padding="6,1" Margin="8,0,0,0" VerticalAlignment="Center"
                                Visibility="{Binding ShowDefaultBadge, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="默认" FontSize="10" Foreground="{StaticResource SubBrush}" />
                        </Border>
                        <Border Background="{StaticResource AccentSoftBrush}" CornerRadius="4"
                                Padding="6,1" Margin="6,0,0,0" VerticalAlignment="Center"
                                Visibility="{Binding ShowRecommendedBadge, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="推荐" FontSize="10" Foreground="{StaticResource AccentBrush}" />
                        </Border>
                    </StackPanel>

                    <TextBlock Margin="0,5,0,0" FontSize="11" Foreground="{StaticResource MutedBrush}">
                        <Run Text="{Binding Parameters, Mode=OneWay}" /> 参数 ·
                        <Run Text="{Binding Quantization, Mode=OneWay}" /> · 下载
                        <Run Text="{Binding SizeText, Mode=OneWay}" />
                    </TextBlock>

                    <TextBlock Text="{Binding RequirementText}" FontSize="11"
                               Foreground="{StaticResource FaintBrush}" Margin="0,3,0,0" />
                    <TextBlock Text="{Binding Note}" FontSize="11"
                               Foreground="{StaticResource FaintBrush}" Margin="0,2,0,0" />
                </StackPanel>

                <TextBlock x:Name="StatusText" Grid.Column="1" Text="{Binding StatusText}" FontSize="11.5"
                           Foreground="#059669" VerticalAlignment="Center" Margin="12,0,0,0" />
            </Grid>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding StatusText}" Value="可运行（配置偏低）">
                    <Setter TargetName="StatusText" Property="Foreground" Value="#B45309" />
                </DataTrigger>
                <DataTrigger Binding="{Binding StatusText}" Value="配置不足">
                    <Setter TargetName="StatusText" Property="Foreground" Value="{StaticResource FaintBrush}" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </Window.Resources>

    <Grid Margin="22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock Text="选择要部署的本地模型" FontSize="18" FontWeight="SemiBold" />
            <TextBlock Text="根据本机配置推荐，可随时更换；标为“配置不足”的模型不建议部署。"
                       FontSize="11.5" Foreground="{StaticResource FaintBrush}" Margin="0,4,0,0" />
        </StackPanel>

        <Border Grid.Row="1" Style="{StaticResource Card}" Padding="18,16" Margin="0,0,0,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="显卡" FontSize="11" Foreground="{StaticResource MutedBrush}" />
                    <TextBlock x:Name="HwGpuText" FontSize="13" FontWeight="SemiBold" Margin="0,4,0,0"
                               TextTrimming="CharacterEllipsis" />
                    <TextBlock x:Name="HwVramText" FontSize="11" Foreground="{StaticResource FaintBrush}"
                               Margin="0,3,0,0" />
                </StackPanel>

                <StackPanel Grid.Column="1">
                    <TextBlock Text="内存" FontSize="11" Foreground="{StaticResource MutedBrush}" />
                    <TextBlock x:Name="HwRamText" FontSize="13" FontWeight="SemiBold" Margin="0,4,0,0" />
                </StackPanel>

                <StackPanel Grid.Column="2">
                    <TextBlock Text="处理器" FontSize="11" Foreground="{StaticResource MutedBrush}" />
                    <TextBlock x:Name="HwCpuText" FontSize="13" FontWeight="SemiBold" Margin="0,4,0,0" />
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Row="2" Style="{StaticResource Card}" Margin="0" Padding="16">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="0,0,0,10">
                    <TextBlock Text="可部署模型" Style="{StaticResource SectionTitle}" />
                    <TextBlock Text="推荐项已预选 · 配置不足的模型会在下一步二次确认" FontSize="11"
                               Foreground="{StaticResource FaintBrush}"
                               HorizontalAlignment="Right" VerticalAlignment="Center" />
                </Grid>

                <ListBox x:Name="ModelList" Grid.Row="1" Background="Transparent" BorderThickness="0"
                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                         ItemContainerStyle="{StaticResource ModelItemStyle}"
                         ItemTemplate="{StaticResource ModelTemplate}"
                         SelectionChanged="OnSelectionChanged" />
            </Grid>
        </Border>

        <!-- 下载进度 -->
        <Border x:Name="DownloadPanel" Grid.Row="3" Visibility="Collapsed" Margin="0,14,0,0"
                Background="White" CornerRadius="10" BorderBrush="{StaticResource LineBrush}"
                BorderThickness="1" Padding="14,12">
            <StackPanel>
                <Grid>
                    <TextBlock x:Name="ProgressTitleText" Text="正在下载模型…" FontSize="12" FontWeight="SemiBold" />
                    <TextBlock x:Name="ProgressPercentText" Text="0%" FontSize="12" FontWeight="SemiBold"
                               Foreground="{StaticResource AccentBrush}" HorizontalAlignment="Right" />
                </Grid>
                <ProgressBar x:Name="DownloadProgressBar" Style="{StaticResource ThinProgressBar}"
                             Minimum="0" Maximum="100" Value="0" Margin="0,8,0,6" />
                <Grid>
                    <TextBlock x:Name="ProgressDetailText" Text="准备中…" FontSize="11"
                               Foreground="{StaticResource FaintBrush}" />
                    <TextBlock x:Name="ProgressSpeedText" Text="" FontSize="11"
                               Foreground="{StaticResource FaintBrush}" HorizontalAlignment="Right" />
                </Grid>
            </StackPanel>
        </Border>

        <Grid Grid.Row="4" Margin="0,16,0,0">
            <TextBlock x:Name="SelectionText" Text="尚未选择模型" FontSize="11.5"
                       Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="CancelButton" Content="取消" Style="{StaticResource GhostButton}" Padding="18,9"
                        Margin="0,0,10,0" Click="OnCancelClick" />
                <Button x:Name="NextButton" Content="下一步" Style="{StaticResource PrimaryButton}" Padding="20,9"
                        Click="OnNextClick" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
