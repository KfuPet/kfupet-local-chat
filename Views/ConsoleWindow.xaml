<Window x:Class="kfupet_local_chat.Views.ConsoleWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:kfupet_local_chat.Views"
        Title="启动控制台"
        Width="1189" Height="688" MinWidth="900" MinHeight="480"
        WindowStartupLocation="CenterScreen" WindowState="Maximized"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        FontFamily="Microsoft YaHei UI" FontSize="13"
        Foreground="{StaticResource InkBrush}">
    <Window.Background>
        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#F8F9FB" Offset="0" />
            <GradientStop Color="#EDEFF3" Offset="1" />
        </LinearGradientBrush>
    </Window.Background>

    <Grid Margin="22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock Text="启动控制台" FontSize="18" FontWeight="SemiBold" />
        </StackPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="380" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- 调用点 -->
            <Border Grid.Column="0" Style="{StaticResource Card}" Margin="0" Padding="18">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Style="{StaticResource ThinScrollViewer}">
                    <StackPanel>
                    <Grid Margin="0,0,0,14">
                        <TextBlock Text="调用点" Style="{StaticResource SectionTitle}" />
                        <TextBlock Text="全部已接入" FontSize="11"
                                   Foreground="{StaticResource FaintBrush}" HorizontalAlignment="Right"
                                   VerticalAlignment="Center" />
                    </Grid>

                    <TextBlock Style="{StaticResource FieldLabel}" Text="主对话" Margin="0,0,0,8" />
                    <Button x:Name="ChatButton" Content="主对话（每轮记忆提取）" Click="OnOpenChatClick"
                            Style="{StaticResource GhostButton}"
                            Margin="0,0,0,8" HorizontalContentAlignment="Left" Padding="14,8" />

                    <Border Height="1" Background="{StaticResource LineBrush}" Margin="0,8,0,16" />

                    <TextBlock Style="{StaticResource FieldLabel}" Text="对话与通知" Margin="0,0,0,8" />
                    <Button x:Name="TouchReactionButton" Content="触摸反应" Click="OnTouchReactionClick"
                            Style="{StaticResource GhostButton}"
                            Margin="0,0,0,8" HorizontalContentAlignment="Left" Padding="14,8" />
                    <Button x:Name="SnapBackButton" Content="拖动越界回正" Click="OnSnapBackClick"
                            Style="{StaticResource GhostButton}"
                            Margin="0,0,0,8" HorizontalContentAlignment="Left" Padding="14,8" />
                    <Button x:Name="ProactiveButton" Content="主动搭话" Click="OnProactiveClick"
                            Style="{StaticResource GhostButton}"
                            Margin="0,0,0,8" HorizontalContentAlignment="Left" Padding="14,8" />
                    <Button x:Name="NotificationButton" Content="更新通知正文" Click="OnUpdateNotificationClick"
                            Style="{StaticResource GhostButton}"
                            HorizontalContentAlignment="Left" Padding="14,8" />

                    <Border Height="1" Background="{StaticResource LineBrush}" Margin="0,16,0,16" />

                    <TextBlock Style="{StaticResource FieldLabel}" Text="记忆系统" Margin="0,0,0,8" />
                    <Button Content="实时核心信息提取（随主对话执行）" Click="OnRealtimeExtractClick"
                            Style="{StaticResource GhostButton}"
                            Margin="0,0,0,8" HorizontalContentAlignment="Left" Padding="14,8" />
                    <Button x:Name="ArchiveExtractButton" Content="归档批量提炼" Click="OnArchiveExtractClick"
                            Style="{StaticResource GhostButton}"
                            Margin="0,0,0,8" HorizontalContentAlignment="Left" Padding="14,8" />
                    <Button x:Name="ScoreButton" Content="单条重评分" Click="OnScoreContentClick"
                            Style="{StaticResource GhostButton}"
                            Margin="0,0,0,8" HorizontalContentAlignment="Left" Padding="14,8" />
                    <Button x:Name="SummarizeButton" Content="多条总结" Click="OnSummarizeClick"
                            Style="{StaticResource GhostButton}"
                            HorizontalContentAlignment="Left" Padding="14,8" />

                    <TextBlock Style="{StaticResource HintText}" Margin="0,16,0,0"
                               Text="1.7B 仅支持短句类调用与单条评分；信息提取与多条总结请切换到 4B 或 8B。" />
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- 输出 + 本地模型输出，各占一半 -->
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="14" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Style="{StaticResource Card}" Margin="0" Padding="16">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0" Margin="0,0,0,10">
                            <TextBlock Text="输出" Style="{StaticResource SectionTitle}" />
                            <Button Content="清空" Click="OnClearOutputClick" Style="{StaticResource GhostButton}"
                                    Padding="10,4" HorizontalAlignment="Right" VerticalAlignment="Center" />
                        </Grid>

                        <Border Grid.Row="1" Background="#FAFBFD" CornerRadius="9"
                                BorderBrush="{StaticResource LineBrush}" BorderThickness="1" Padding="12,8">
                            <Grid>
                                <TextBlock x:Name="PlaceholderText" Text="点击左侧任意调用点，输出会显示在这里。"
                                           FontSize="12" Foreground="{StaticResource FaintBrush}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                                <ListBox x:Name="OutputList" Background="Transparent" BorderThickness="0"
                                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                                         ItemContainerStyle="{StaticResource LogItem}" />
                            </Grid>
                        </Border>
                    </Grid>
                </Border>

                <views:ResultCard x:Name="ConsoleResultView" Grid.Row="2" Margin="0" />
            </Grid>
        </Grid>
    </Grid>
</Window>
