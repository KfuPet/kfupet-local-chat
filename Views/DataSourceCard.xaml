<UserControl x:Class="kfupet_local_chat.Views.DataSourceCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Border Style="{StaticResource Card}">
        <StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                <Border Width="3" Height="14" CornerRadius="2" Background="{StaticResource AccentBrush}"
                        VerticalAlignment="Center" Margin="0,0,8,0" />
                <TextBlock Text="数据源" Style="{StaticResource SectionTitle}" />
            </StackPanel>

            <TextBlock Style="{StaticResource FieldLabel}" Text="归档记忆 ArchiveMemory.json" />
            <Border Background="{StaticResource SoftBrush}" CornerRadius="8" Padding="10,9"
                    BorderBrush="{StaticResource LineBrush}" BorderThickness="1" Margin="0,0,0,10">
                <Grid>
                    <TextBlock Text="尚未载入" FontSize="12" Foreground="{StaticResource FaintBrush}" />
                    <TextBlock x:Name="ArchiveCountText" Text="— 条" FontSize="12"
                               Foreground="{StaticResource SubBrush}" HorizontalAlignment="Right" />
                </Grid>
            </Border>

            <TextBlock Style="{StaticResource FieldLabel}" Text="长期记忆 LongMemory.json" />
            <Border Background="{StaticResource SoftBrush}" CornerRadius="8" Padding="10,9"
                    BorderBrush="{StaticResource LineBrush}" BorderThickness="1" Margin="0,0,0,10">
                <Grid>
                    <TextBlock Text="尚未载入" FontSize="12" Foreground="{StaticResource FaintBrush}" />
                    <TextBlock x:Name="LongCountText" Text="— 条" FontSize="12"
                               Foreground="{StaticResource SubBrush}" HorizontalAlignment="Right" />
                </Grid>
            </Border>

            <Button Content="选择归档文件" Tag="选择归档文件" Style="{StaticResource GhostButton}"
                    Margin="0,2,0,0" />
            <Button Content="载入真实记忆副本（只读）" Tag="载入真实记忆副本" Style="{StaticResource PrimaryButton}"
                    Margin="0,10,0,0" />

            <TextBlock Style="{StaticResource HintText}" Margin="0,10,0,0"
                       Text="只复制到本项目 data/ 目录读取，不写入 %AppData%\KfuPet\Memory。" />
        </StackPanel>
    </Border>
</UserControl>
