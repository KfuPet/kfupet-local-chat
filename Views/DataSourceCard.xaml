<UserControl x:Class="kfupet_local_chat.Views.DataSourceCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Border Style="{StaticResource Card}">
        <StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                <Border Width="3" Height="14" CornerRadius="2" Background="{StaticResource AccentBrush}"
                        VerticalAlignment="Center" Margin="0,0,8,0" />
                <TextBlock Text="数据源" Style="{StaticResource SectionTitle}" />
            </StackPanel>

            <TextBlock Style="{StaticResource FieldLabel}" Text="归档记忆 ArchiveMemory.json" />
            <Border Background="{StaticResource SoftBrush}" CornerRadius="8" Padding="10,9"
                    BorderBrush="{StaticResource LineBrush}" BorderThickness="1" Margin="0,0,0,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="ArchiveFileText" Text="尚未选择" FontSize="12"
                               Foreground="{StaticResource FaintBrush}" TextTrimming="CharacterEllipsis" />
                    <TextBlock x:Name="ArchiveCountText" Grid.Column="1" Text="— 条" FontSize="12"
                               Foreground="{StaticResource SubBrush}" Margin="8,0,0,0" />
                </Grid>
            </Border>

            <TextBlock Style="{StaticResource FieldLabel}" Text="本试点长期记忆 memories.json" />
            <Border Background="{StaticResource SoftBrush}" CornerRadius="8" Padding="10,9"
                    BorderBrush="{StaticResource LineBrush}" BorderThickness="1" Margin="0,0,0,10">
                <Grid>
                    <TextBlock Text="提炼结果写入这里" FontSize="12" Foreground="{StaticResource FaintBrush}" />
                    <TextBlock x:Name="PilotLongCountText" Text="— 条" FontSize="12"
                               Foreground="{StaticResource SubBrush}" HorizontalAlignment="Right" />
                </Grid>
            </Border>

            <Button Content="选择归档文件" Tag="选择归档文件" Style="{StaticResource GhostButton}"
                    Margin="0,2,0,0" />

            <TextBlock Style="{StaticResource HintText}" Margin="0,10,0,0"
                       Text="手动选择归档 JSON 文件；提炼结果只写入本试点的长期记忆。" />
        </StackPanel>
    </Border>
</UserControl>
