<UserControl x:Class="kfupet_local_chat.Views.EngineCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Border Style="{StaticResource Card}">
        <StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                <Border Width="3" Height="12" CornerRadius="2" Background="{StaticResource AccentBrush}"
                        VerticalAlignment="Center" Margin="0,0,8,0" />
                <TextBlock Text="本地推理引擎" Style="{StaticResource SectionTitle}" />
            </StackPanel>

            <TextBlock Style="{StaticResource FieldLabel}" Text="运行方式" />
            <Border Background="{StaticResource SoftBrush}" CornerRadius="8" Padding="10,9"
                    BorderBrush="{StaticResource LineBrush}" BorderThickness="1">
                <Grid>
                    <TextBlock Text="LLamaSharp（进程内）" FontSize="12"
                               Foreground="{StaticResource InkBrush}" />
                    <TextBlock Text="内置，无需安装" FontSize="11"
                               Foreground="{StaticResource FaintBrush}" HorizontalAlignment="Right" />
                </Grid>
            </Border>

            <TextBlock Style="{StaticResource FieldLabel}" Text="推理设备" Margin="0,10,0,4" />
            <ComboBox x:Name="DeviceCombo" SelectionChanged="OnDeviceChanged"
                      PreviewMouseWheel="OnComboPreviewMouseWheel">
                <ComboBoxItem Content="自动（按显存判断）" />
                <ComboBoxItem Content="GPU 加速" />
                <ComboBoxItem Content="纯 CPU" />
            </ComboBox>

            <Button x:Name="DownloadButton" Content="下载模型" Tag="下载模型"
                    Style="{StaticResource PrimaryButton}" Margin="0,10,0,0" />

            <!-- 已部署后显示的模型管理区 -->
            <StackPanel x:Name="ManagePanel" Visibility="Collapsed" Margin="0,12,0,0">
                <TextBlock Style="{StaticResource FieldLabel}" Text="已下载模型" Margin="0,0,0,4" />
                <ComboBox x:Name="ModelCombo" TextSearch.TextPath="DisplayText"
                          SelectionChanged="OnModelSelectionChanged"
                          PreviewMouseWheel="OnComboPreviewMouseWheel" Margin="0,0,0,10">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding DisplayText}" TextTrimming="CharacterEllipsis" />
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>

                <Border Background="{StaticResource SoftBrush}" CornerRadius="8" Padding="12,10"
                        BorderBrush="{StaticResource LineBrush}" BorderThickness="1">
                    <StackPanel>
                        <TextBlock x:Name="ModelSizeText" Text="—" FontSize="11"
                                   Foreground="{StaticResource FaintBrush}" />
                        <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                            <Ellipse x:Name="StateDot" Width="8" Height="8" Fill="#A1A1AA"
                                     VerticalAlignment="Center" />
                            <TextBlock x:Name="RuntimeStatusText" Text="已停止" FontSize="11"
                                       Foreground="{StaticResource MutedBrush}" Margin="7,0,0,0"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Button x:Name="UninstallButton" Content="卸载当前模型" Tag="卸载模型"
                        Style="{StaticResource GhostButton}" Margin="0,10,0,0" Padding="8,8" />
            </StackPanel>

            <Border Background="{StaticResource SoftBrush}" CornerRadius="8" Padding="12,10"
                    BorderBrush="{StaticResource LineBrush}" BorderThickness="1" Margin="0,12,0,0">
                <StackPanel>
                    <TextBlock x:Name="HwGpuText" Text="尚未检测" FontSize="12"
                               Foreground="{StaticResource InkBrush}" TextTrimming="CharacterEllipsis" />
                    <TextBlock x:Name="HwVramText" Text=" " FontSize="11"
                               Foreground="{StaticResource MutedBrush}" Margin="0,3,0,0" />
                    <TextBlock x:Name="HwSysText" Text="点击“下载模型”读取本机配置" FontSize="11"
                               Foreground="{StaticResource FaintBrush}" Margin="0,2,0,0" />
                </StackPanel>
            </Border>

            <TextBlock Style="{StaticResource HintText}" Margin="0,10,0,0"
                       Text="LLamaSharp 已内置在应用里，用户无需安装 Ollama 等外部服务。" />
        </StackPanel>
    </Border>
</UserControl>
