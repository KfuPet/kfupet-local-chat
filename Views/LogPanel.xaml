<UserControl x:Class="kfupet_local_chat.Views.LogPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Border Style="{StaticResource Card}" Margin="0" Padding="16">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="0,0,0,8">
                <TextBlock Text="运行日志" Style="{StaticResource SectionTitle}" />
                <Button Content="清空" Click="OnClearClick" Style="{StaticResource GhostButton}"
                        Padding="10,4" HorizontalAlignment="Right" VerticalAlignment="Center" />
            </Grid>

            <Border Grid.Row="1" Background="#FAFBFD" CornerRadius="9"
                    BorderBrush="{StaticResource LineBrush}" BorderThickness="1" Padding="10,6">
                <ListBox x:Name="LogList" Background="Transparent" BorderThickness="0"
                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                         ItemContainerStyle="{StaticResource LogItem}" />
            </Border>
        </Grid>
    </Border>
</UserControl>
