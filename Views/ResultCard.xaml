<UserControl x:Class="kfupet_local_chat.Views.ResultCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Border Style="{StaticResource Card}" Margin="0">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0">
                <StackPanel Orientation="Horizontal">
                    <Ellipse Width="8" Height="8" Fill="#4C6FFF" VerticalAlignment="Center" />
                    <TextBlock Text="本地模型输出" Style="{StaticResource SectionTitle}" Margin="8,0,0,0" />
                </StackPanel>
                <TextBlock x:Name="StatusText" Text="尚未运行" FontSize="11.5"
                           Foreground="{StaticResource FaintBrush}" HorizontalAlignment="Right"
                           VerticalAlignment="Center" />
            </Grid>

            <Border Grid.Row="1" Margin="0,12,0,12" CornerRadius="10" Background="#FBFBFC">
                <Grid>
                    <Rectangle Margin="1" RadiusX="9" RadiusY="9" Stroke="#DCDCE1" StrokeThickness="1"
                               StrokeDashArray="4 3" Fill="Transparent" />
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock x:Name="EmptyHint" Text="输出将显示在这里" FontSize="12.5"
                                   Foreground="{StaticResource MutedBrush}" HorizontalAlignment="Center" />
                        <TextBlock Text="提醒词 / JSON 数组 / 耗时与显存" FontSize="11"
                                   Foreground="{StaticResource FaintBrush}" HorizontalAlignment="Center"
                                   Margin="0,6,0,0" />
                    </StackPanel>
                </Grid>
            </Border>

            <UniformGrid Grid.Row="2" Columns="3">
                <Border Style="{StaticResource MetricChip}">
                    <StackPanel>
                        <TextBlock Text="JSON 合法率" FontSize="10.5" Foreground="{StaticResource FaintBrush}" />
                        <TextBlock x:Name="JsonRateText" Text="—" FontSize="13" FontWeight="SemiBold" Margin="0,2,0,0" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource MetricChip}">
                    <StackPanel>
                        <TextBlock Text="提炼条数" FontSize="10.5" Foreground="{StaticResource FaintBrush}" />
                        <TextBlock x:Name="ItemCountText" Text="—" FontSize="13" FontWeight="SemiBold" Margin="0,2,0,0" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource MetricChip}">
                    <StackPanel>
                        <TextBlock Text="耗时" FontSize="10.5" Foreground="{StaticResource FaintBrush}" />
                        <TextBlock x:Name="ElapsedText" Text="—" FontSize="13" FontWeight="SemiBold" Margin="0,2,0,0" />
                    </StackPanel>
                </Border>
            </UniformGrid>
        </Grid>
    </Border>
</UserControl>
