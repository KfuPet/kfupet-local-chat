<UserControl x:Class="kfupet_local_chat.Views.ScopeCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Border Style="{StaticResource Card}">
        <StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                <Border Width="3" Height="14" CornerRadius="2" Background="{StaticResource AccentBrush}"
                        VerticalAlignment="Center" Margin="0,0,8,0" />
                <TextBlock Text="试点项" Style="{StaticResource SectionTitle}" />
            </StackPanel>

            <CheckBox Content="归档批量提炼（22 条 → JSON 数组）" IsChecked="True" Margin="0,2,0,8" />
            <CheckBox Content="单条重要性评分（0~5）" IsChecked="True" Margin="0,0,0,8" />
            <CheckBox Content="多条信息总结成一句" IsChecked="True" />

            <Border Height="1" Background="{StaticResource LineBrush}" Margin="0,14,0,12" />

            <TextBlock Style="{StaticResource FieldLabel}" Text="验收线" Margin="0,0,0,6" />
            <TextBlock Style="{StaticResource HintText}"
                       Text="JSON 合法率 100% · 不提炼“（主动搭话）” · 无重复条目 · 单批 ≤ 20s" />
        </StackPanel>
    </Border>
</UserControl>
